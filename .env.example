# Copy to .env then fill in — .env is chmod 600, do not commit.
# Public domain in Cloudflare (DNS zone), used by traefik Host() labels.
PUBLIC_DOMAIN=example.com
# Host UID/GID for the cloudflared container (reads secrets/ cf-tunnel.yml 600)
PUID=1000
PGID=1000

# --- Cloudflare identity (used by the portal + ./publish) ---
# Zone / account / tunnel ids come from your own CF account; keep them in .env only.
CF_ZONE_ID=00000000000000000000000000000000
CF_ACCOUNT_ID=00000000000000000000000000000000
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
# Email used for portal access notes (optional).
PORTAL_ACCESS_EMAIL=you@example.com
