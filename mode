#!/usr/bin/env bash
# infra mode switcher — desktop | lite | lab | status
# desktop: all containers DOWN (no -v, data & secrets kept)
# lite    : traefik + cloudflared + lite service profile (public enabled)
# lab     : lite + dozzle + postgres-lite
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

usage() {
  cat <<'EOF'
Usage: ./mode desktop|lite|lab|status

  desktop  Stop+remove all containers (NO -v) — saves resources, public OFF
  lite     traefik + cloudflared + lite service profile — public ON
  lab      lite + dozzle + postgres-lite
  status   df, free, docker compose ls/ps, docker system df

Notes:
  - desktop & lite modes also disable public access (cloudflared goes down too).
  - public/private switch = change mode, not edit compose.
EOF
  exit "${1:-2}"
}

require_docker() {
  command -v docker >/dev/null || { echo "docker not found" >&2; exit 1; }
  docker info >/dev/null 2>&1 || { echo "docker daemon not running / needs sudo" >&2; exit 1; }
}

cmd="${1:-}"
case "$cmd" in
  desktop)
    require_docker
    docker compose --profile lite --profile lab down
    ;;
  lite)
    require_docker
    docker compose --profile lite up -d
    ;;
  lab)
    require_docker
    docker compose --profile lite --profile lab up -d
    ;;
  status)
    require_docker
    df -h / /boot
    echo
    free -h
    echo
    docker compose ls
    echo
    docker compose --profile lite --profile lab ps -a
    echo
    docker system df
    ;;
  *)
    usage
    ;;
esac
